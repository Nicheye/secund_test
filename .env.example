# Copy to .env (`cp .env.example .env`). Docker Compose reads it for variable substitution;
# the app also reads it when run on the host. Placeholder values only, never commit real secrets.

# Docker Compose only: infrastructure credentials. Compose builds DATABASE_URL and
# RABBITMQ_URL from these using the service hostnames.
POSTGRES_USER=payments
POSTGRES_PASSWORD=payments
POSTGRES_DB=payments
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# Host runs only (ignored by Docker Compose, which sets its own).
DATABASE_URL=postgresql+asyncpg://payments:payments@localhost:5432/payments
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

API_KEY=change-me
# Docker Compose only: host port for the API.
API_PORT=8000
RELAY_POLL_INTERVAL_SECONDS=1.0
RELAY_BATCH_SIZE=50
CONSUMER_PREFETCH_COUNT=10
WEBHOOK_MAX_ATTEMPTS=3
WEBHOOK_BACKOFF_BASE_SECONDS=1.0
WEBHOOK_TIMEOUT_SECONDS=5.0
GATEWAY_MIN_SECONDS=2
GATEWAY_MAX_SECONDS=5
GATEWAY_SUCCESS_RATE=0.9
